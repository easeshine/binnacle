{
  "name": "binnacle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run docs#content && vp check && vp run -r test && vp run -r build",
    "dev": "vp run docs#dev",
    "test": "vp test",
    "refs": "node scripts/refs.mjs",
    "prepare": "vp config && vp run docs#content"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@oxlint/plugins": "catalog:",
    "semver": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
