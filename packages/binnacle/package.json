{
  "name": "@easeshine/binnacle",
  "version": "0.0.0",
  "description": "A terminal app for DeepSeek Harness, mounted as a dsh bundle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easeshine/binnacle.git",
    "directory": "packages/binnacle"
  },
  "type": "module",
  "bin": {
    "binnacle": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "NOTICE",
    "docs",
    "skills",
    "src",
    "!src/**/AGENTS.md"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./plugins/commands": "./dist/plugins/commands/index.mjs",
    "./plugins/composer": "./dist/plugins/composer/index.mjs",
    "./plugins/notice": "./dist/plugins/notice/index.mjs",
    "./plugins/requests": "./dist/plugins/requests/index.mjs",
    "./plugins/requests-view": "./dist/plugins/requests-view/index.mjs",
    "./plugins/status-line": "./dist/plugins/status-line/index.mjs",
    "./plugins/tool-cards": "./dist/plugins/tool-cards/index.mjs",
    "./plugins/transcript": "./dist/plugins/transcript/index.mjs",
    "./plugins/transcript-view": "./dist/plugins/transcript-view/index.mjs",
    "./testing": "./dist/testing/index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "prepack": "vp pack"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "15.0.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.11",
    "@xterm/headless": "5.5.0",
    "semver": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-cmdline": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-ask-user": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "@types/semver": "7.8.0"
  }
}
